def slow_fetch(query: str, page: int) -> tuple[str, int]:
    time.sleep(0.01)
    if query == "boom":
        raise RuntimeError("backend down")
    FETCHED.append((query, page))
    return (query, page)


class SearchApp(App[None]):
    # Bind the sample's methods; show_rows and notify are the app's own.
    search = search
    on_worker_state_changed = on_worker_state_changed

    def __init__(self) -> None:
        super().__init__()
        self.shown: list[tuple[str, int]] = []
        self.errors: list[str] = []

    def show_rows(self, rows: tuple[str, int]) -> None:
        self.shown.append(rows)

    def notify(self, message: str, **kwargs) -> None:
        self.errors.append(message)


class _Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        body = b"fetched"
        self.send_response(200)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args) -> None:
        pass


class Panel(Static):
    # A widget has no call_from_thread of its own; the sample reaches it via self.app.
    compute_heavy = compute_heavy

    def update_result(self, result: str) -> None:
        self.update(result)


class PanelApp(App[None]):
    def compose(self) -> ComposeResult:
        yield Panel()


@pytest.mark.asyncio
async def test_async_worker_fetches(monkeypatch):
    monkeypatch.setenv("NO_PROXY", "127.0.0.1")
    server = ThreadingHTTPServer(("127.0.0.1", 0), _Handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    try:
        app = WorkerApp()
        async with app.run_test() as pilot:
            await app.fetch_data(f"http://127.0.0.1:{server.server_port}/").wait()
            await pilot.pause()
            assert str(app.query_one("#result", Static).content) == "fetched"
    finally:
        server.shutdown()


@pytest.mark.asyncio
async def test_thread_worker_updates_through_call_from_thread():
    app = WorkerApp()
    async with app.run_test() as pilot:
        await app.compute_heavy().wait()
        await pilot.pause()
        assert str(app.query_one("#result", Static).content) == "computed"


@pytest.mark.asyncio
async def test_widget_thread_worker_reaches_call_from_thread_through_app():
    app = PanelApp()
    async with app.run_test() as pilot:
        panel = app.query_one(Panel)
        assert not hasattr(panel, "call_from_thread")
        await panel.compute_heavy().wait()
        await pilot.pause()
        assert str(panel.content) == "computed"


@pytest.mark.asyncio
async def test_new_search_cancels_the_previous_thread_worker():
    FETCHED.clear()
    app = SearchApp()
    async with app.run_test():
        first = app.search("a")
        async with asyncio.timeout(5):
            while not FETCHED:
                await asyncio.sleep(0.005)
        app.search("b")
        await asyncio.sleep(0.6)
        assert first.is_cancelled
        assert len([row for row in app.shown if row[0] == "a"]) < 20  # stopped by polling the flag
        assert len([row for row in app.shown if row[0] == "b"]) == 20


@pytest.mark.asyncio
async def test_worker_error_reaches_state_handler_without_exiting():
    app = SearchApp()
    async with app.run_test():
        app.search("boom")
        await asyncio.sleep(0.2)
        assert app.errors == ["backend down"]
        assert app.is_running
